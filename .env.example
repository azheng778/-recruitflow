# RecruitFlow application
APP_NAME=RecruitFlow
APP_ENV=development
DEBUG=false
APP_TIMEZONE=Asia/Shanghai
SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEMO_PASSWORD=RecruitFlow!2026

# MySQL: DB_NAME must never be langchain_db
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hr_recruitment
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
TEST_DB_NAME=hr_recruitment_test

# OpenAI-compatible Qwen endpoint
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-max-2026-06-08
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_ENABLE_THINKING=false
LLM_THINKING_BUDGET=256
RESPONSE_LLM_ENABLED=true
RESPONSE_LLM_MODEL=
RESPONSE_LLM_TIMEOUT_SECONDS=8
RESPONSE_LLM_MAX_RETRIES=1
RESPONSE_LLM_THINKING_BUDGET=128
AGENT_V2_ENABLED=true
AGENT_V2_SHADOW_MODE=false
AGENT_MEMORY_ENABLED=true
AGENT_LLM_ROUTER_ENABLED=true
AGENT_READ_CONFIDENCE=0.75
AGENT_WRITE_CONFIDENCE=0.85
AGENT_RECENT_MESSAGE_LIMIT=12
AGENT_MAX_TOOL_STEPS=3
AGENT_PROMPT_VERSION=recruitflow-agent-v2.0
AGENT_TRACE_ENABLED=false
AGENT_TRACE_DIR=./backend/data/test-artifacts
AGENT_TRACE_SAMPLE_RATE=1.0
AGENT_TRACE_SQL_TEXT=false
BACKGROUND_WORKER_ENABLED=true

# Local persistence
LANGGRAPH_CHECKPOINT_PATH=./data/langgraph_checkpoints.sqlite
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports
MAX_RESUME_SIZE_MB=10

# Enterprise WeChat adapter (disabled by default)
WECOM_ENABLED=false
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_GROUP_BOT_WEBHOOK=

# Tencent Docs adapter (disabled by default)
TENCENT_DOCS_ENABLED=false
TENCENT_DOCS_BASE_URL=
TENCENT_DOCS_CLIENT_ID=
TENCENT_DOCS_CLIENT_SECRET=
TENCENT_DOCS_DOCUMENT_ID=

# Worker and logging
NOTIFICATION_POLL_SECONDS=60
SYNC_MAX_RETRIES=3
LOG_LEVEL=INFO

ALIYUN_OCR_ENDPOINT=https://gjbsb.market.alicloudapi.com/ocrservice/advanced
ALIYUN_OCR_APPCODE=
ALIYUN_OCR_TIMEOUT_SECONDS=20
ALIYUN_OCR_MAX_PAGE_COUNT=10
